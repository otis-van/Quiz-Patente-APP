{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true
    },
    "ios-unsigned": {
      "distribution": "internal",
      "ios": {
        "withoutCredentials": true,
        "image": "latest",
        "config": "ios-unsigned.yml"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
